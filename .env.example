# Optional — only needed if you're NOT using subscription login (claude login).
# If set, it takes precedence over subscription login and uses pay-as-you-go
# billing instead of your Pro/Max plan quota.
# ANTHROPIC_API_KEY=sk-ant-...

# Required — used by classify_task (first attempt) and run_security_review
# (fallback provider is Gemini, then Claude Haiku if both fail). Same accounts
# already used by ai-service; note that names here are GROQ_API_KEY/
# GEMINI_API_KEY exactly, not GROG_API_KEY/DEFAULT_GEMINI_API_KEY like
# ai-service's .env — that repo's names don't match what the groq/google-genai
# SDKs read by default, worth double-checking there too.
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=...

# Optional — Postgres for run history (RunEvent) and per-call cost telemetry
# (ExecutionMetric). Leave it unset to run without persistence: everything still
# works, the dashboard is just live-only. To enable it, create the tables with
#   psql "$DATABASE_URL" -f schema.sql
# (or reuse a database that already has them, e.g. the sibling backend project's).
# DATABASE_URL=postgresql://...

# Optional — origin control_server.py's CORS middleware allows to actually
# call it from a browser (POST /runs, GET /repos, the /ws WebSocket).
# Defaults to Vite's local dev server if unset - override this once the
# dashboard runs somewhere other than localhost.
# DASHBOARD_ORIGIN=http://localhost:5173