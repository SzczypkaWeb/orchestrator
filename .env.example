# Optional — only needed if you're NOT using subscription login (claude login).
# If set, it takes precedence over subscription login and uses pay-as-you-go
# billing instead of your Pro/Max plan quota.
# ANTHROPIC_API_KEY=sk-ant-...

# Required — used by classify_task (first attempt) and run_security_review
# (fallback provider is Gemini, then Claude Haiku if both fail). Same accounts
# already used by ai-service; note that names here are GROQ_API_KEY/
# GEMINI_API_KEY exactly, not GROG_API_KEY/DEFAULT_GEMINI_API_KEY like
# ai-service's .env — that repo's names don't match what the groq/google-genai
# SDKs read by default, worth double-checking there too.
GROQ_API_KEY=gsk_...
GEMINI_API_KEY=...